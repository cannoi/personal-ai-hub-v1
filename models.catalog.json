{
  "version": 1,
  "description": "Conservative model-family tiers used for default ordering only. Provider discovery remains authoritative for availability.",
  "tiers": {
    "flagship": 100,
    "standard": 70,
    "fast": 45,
    "tiny": 20
  },
  "families": [
    {
      "tier": "flagship",
      "patterns": [
        "^gpt-5(?!-(?:mini|nano|chat))",
        "^gpt-4\\.1(?!-mini)",
        "^gpt-4o(?!-mini)",
        "^o[134](?!-mini)",
        "claude.*(?:opus|sonnet)",
        "gemini.*(?:pro)",
        "deepseek.*reason",
        "(?:^|[-:])(?:70b|72b|405b)(?:[-:]|$)",
        "mistral-large",
        "grok-[4-9]"
      ]
    },
    {
      "tier": "standard",
      "patterns": [
        "^gpt-5(?:-chat)?$",
        "^gpt-5-mini",
        "^gpt-4\\.1-mini",
        "^gpt-4o-mini",
        "^o[134]-mini",
        "claude.*sonnet",
        "deepseek",
        "gemini.*flash(?!.*lite)",
        "grok-3",
        "mistral-small",
        "llama.*(?:70b|90b)"
      ]
    },
    {
      "tier": "fast",
      "patterns": [
        "gemini.*flash",
        "claude.*haiku",
        "\\bmini\\b",
        "instant",
        "mistral-small",
        "grok.*mini",
        "llama.*(?:8b|11b|13b)"
      ]
    },
    {
      "tier": "tiny",
      "patterns": [
        "flash-lite",
        "nano",
        "\\btiny\\b",
        "(?:^|[-:])(?:1b|3b|7b|8b)(?:[-:]|$)",
        "gpt-3\\.5",
        "phi.*mini"
      ]
    }
  ],
  "defaultUnknownTier": "standard",
  "capabilityHints": {
    "vision": [
      "gpt-4o",
      "gpt-4\\.1",
      "gemini",
      "claude-3",
      "claude-sonnet",
      "llava",
      "qwen.*vl"
    ],
    "tools": [
      "gpt-",
      "claude",
      "gemini",
      "deepseek",
      "mistral",
      "qwen",
      "llama"
    ],
    "embeddings": [
      "embed",
      "embedding",
      "text-embedding",
      "nomic-embed",
      "bge-",
      "e5-"
    ]
  }
}
